# Zentrale Umgebungskonfiguration
# Kopiere diese Datei zu .env und passe die Werte an

# Umgebung (development, production, docker)
NODE_ENV=development
ENVIRONMENT=development

# Host-Konfiguration
HOST=localhost

# Service-Ports
BACKEND_PORT=4001
FRONTEND_PORT=3003
ANALYZER_PORT=8001
AUDIO_SERVICE_PORT=5679
AUDIO_SEPARATION_SERVICE_PORT=8003
SALIENCY_SERVICE_PORT=8002
VISION_SERVICE_PORT=8004

# Storage-Pfade
STORAGE_BASE_PATH=/Volumes/DOCKER_EXTERN/prismvid/storage
STORAGE_AUDIO_STEMS=/Volumes/DOCKER_EXTERN/prismvid/storage/audio_stems
STORAGE_VIDEOS=/Volumes/DOCKER_EXTERN/prismvid/storage/videos
STORAGE_VIDEOS=/Volumes/DOCKER_EXTERN/prismvid/storage/videos
STORAGE_KEYFRAMES=/Volumes/DOCKER_EXTERN/prismvid/storage/keyframes

# Qwen VL Konfiguration
# QWEN_VL_SERVICE_URL=http://localhost:8081
# Setze auf true, um Base64-Upload statt Dateipfade zu verwenden (nötig für externe Hosts)
# QWEN_VL_REMOTE_MODE=true
# Provider: 'custom' (Standard), 'ollama', oder 'openai' (GPT Vision + Structured Outputs; benötigt OPENAI_API_KEY)
# QWEN_VL_PROVIDER=ollama
# QWEN_VL_MODEL=qwen3-vl:8b
# Bei QWEN_VL_PROVIDER=openai: Vision-Modell (z. B. gpt-5.4-nano); optional OPENAI_VISION_MODEL überschreibt QWEN_VL_MODEL
# OPENAI_API_KEY=sk-...
# QWEN_VL_PROVIDER=openai
# QWEN_VL_MODEL=gpt-5.4-nano
# OPENAI_VISION_MODEL=gpt-5.4-nano

# Analyzer: limit concurrent CPU-heavy jobs in one process (optional)
# ANALYZER_MAX_CONCURRENT_HEAVY_JOBS=2
# ANALYZER_MAX_CONCURRENT_TRANSCRIPTIONS=1

# Backend: stagger analyzer calls (scene pipeline first, then audio + saliency after ANALYZED)
# ANALYSIS_STAGGER_JOBS=true
# ANALYSIS_PIPELINE_POLL_MS=2000
# ANALYSIS_SCENE_WAIT_TIMEOUT_MS=21600000

# Optional: same secret on backend (INTERNAL_SERVICE_TOKEN) and analyzer (BACKEND_INTERNAL_TOKEN)
# so the analyzer can call protected API routes (Qwen trigger, search index) with header x-internal-service
# INTERNAL_SERVICE_TOKEN=